# EJEMPLO SOLO PARA DESARROLLO LOCAL - NO USAR EN PRODUCCIÓN
APP_NAME=api

# JWT
JWT_SECRET=dev_super_secret_key_with_minimum_32_chars_length_1234
JWT_ISSUER=fastapi-example
JWT_AUDIENCE=fastapi-clients
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
JWT_CLOCK_SKEW=5

# Postgres (driver psycopg)
PSQL_USER=postgres
PSQL_PASSWORD=postgres
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_DB=fastapijwt
